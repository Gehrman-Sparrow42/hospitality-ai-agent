# ===============================================
# WhatsApp AI Camp Assistant Configuration
# ===============================================

# -----------------------------------------------
# OPTION A: Cloud LLM API (RECOMMENDED FOR VDS)
# -----------------------------------------------
# Provider: openai | groq | openrouter | gemini | ollama
LLM_PROVIDER=openai
LLM_API_KEY=sk-proj-YOUR_OPENAI_OR_GROQ_KEY_HERE
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# Örnek Groq Ayarları (Çok ucuz / ücretsiz ve süper hızlı):
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_YOUR_GROQ_KEY
# LLM_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------
# OPTION B: Local Ollama (Only if running locally)
# -----------------------------------------------
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b

# Backend Settings
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=chat_memory.db
HISTORY_LIMIT=6
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_DAILY=30

# WhatsApp Bridge Settings
BACKEND_WEBHOOK_URL=http://127.0.0.1:8000/webhook
WEBHOOK_TIMEOUT_MS=60000
AUTH_DATA_PATH=./.wwebjs_auth
TRIGGER_PREFIX=-test
